# =============================================================
# mirobody-eval Configuration
# Copy this file to .env and fill in your values
# =============================================================

# ---- LLM API keys — at least one ----
#
# A run drives up to three models independently: the virtual user, the target,
# and the judge (--user-model / --target-model / --eval-model).
#
# The Quick Start uses OpenAI models for the target and judge. Set a real
# OpenRouter key below, or set OPENAI_API_KEY for direct access. Leave unused
# keys empty or commented out; a placeholder is not a usable credential.
# Explicit OpenRouter syntax: --eval-model openrouter:openai/gpt-5-mini
OPENROUTER_API_KEY=

# Other providers require explicit model choices for each LLM role, e.g.
# --target-model google:YOUR_MODEL_ID --eval-model google:YOUR_MODEL_ID
# For auto-user datasets, also set --user-model to an available model.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=             # Gemini Developer API
# GEMINI_API_KEY=             # alternative accepted by the Google SDK
# Vertex AI can use Application Default Credentials instead of an API key.

# HuggingFace token (optional for public datasets)
# Get one at https://huggingface.co/settings/tokens
# HF_TOKEN=

# ---- More providers (optional) ----
#
# Reached by prefixing the model name, e.g. --eval-model dashscope:YOUR_MODEL_ID.
# Select a model available to your account. These keys configure the evaluation
# process; the mirobody server has its own model and embedding configuration.
#
# DASHSCOPE_API_KEY=          # dashscope:YOUR_MODEL_ID
# DEEPSEEK_API_KEY=           # deepseek:YOUR_MODEL_ID
# MOONSHOT_API_KEY=           # moonshot:YOUR_MODEL_ID
# ZHIPU_API_KEY=              # zhipu:YOUR_MODEL_ID
# VOLCENGINE_API_KEY=         # volcengine:YOUR_MODEL_ID
#
# Each also honours a <PROVIDER>_BASE_URL override if you front it with a proxy.

# ---- Timeouts (optional) ----
#
# Framework LLM-call budget. The mirobody target also uses this as its default
# per-chat-request budget; override MIROBODY_TIMEOUT for longer agent runs.
# AGENT_LLM_TIMEOUT=840

# Web UI (all optional)
# HOLYEVAL_WEB_PORT=8000        # default 8000
# HOLYEVAL_HEALTH_PORT=8001     # default 8001
# HOLYEVAL_RELOAD=false         # true enables uvicorn auto-reload

# ---- Optional: your own OpenAI-compatible gateway (vLLM / LiteLLM / a proxy) ----
# Any model name written as "[label]actual-model" is routed here instead of the
# default providers. Leave unset if you don't use one.
HOLYEVAL_GATEWAY_BASE_URL=
HOLYEVAL_GATEWAY_API_KEY=

# ---- Optional: --target-type mirobody ----
# Only needed to score a self-hosted mirobody deployment. These say WHICH
# deployment you are pointing at, so they live here rather than in a dataset.
# Requires `uv sync --extra mirobody --python 3.12`.
#
# MIROBODY_CONFIG points at that deployment's own config file. Without it the
# engine searches the current working directory — this repo, not the deployment
# — and falls back to built-in defaults, which surfaces as a connection error
# against a database named after your OS user.
# MIROBODY_CONFIG=/absolute/path/to/mirobody/config.localdb.yaml
# MIROBODY_BASE_URL=http://localhost:18080   # default
# MIROBODY_TIMEOUT=840                     # per-turn override; unset uses AGENT_LLM_TIMEOUT (default 840)
# MIROBODY_PROVIDER=                         # empty = the deployment's own default
# CONFIG_ENCRYPTION_KEY=                    # same key as the deployment, if its config is encrypted
